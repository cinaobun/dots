[global]
    origin = top-right
    offset = (0, 12)
    width = 360
    padding = 12
    horizontal_padding = 8
    frame_width = 1
    frame_color = "#444444"
    corner_radius = 0
    separator_height = 0
    gap_size = 6
    transparency = 0
    font = monospace 12
    format = "<b>%s</b>\n%b"
    alignment = center
    word_wrap = yes
    ellipsize = end
    icon_position = off
    show_age_threshold = -1
    stack_duplicates = true

[urgency_low]
    background = "#000000"
    foreground = "#ffffff"
    timeout = 5

[urgency_normal]
    background = "#000000"
    foreground = "#ffffff"
    timeout = 5

[urgency_critical]
    background = "#000000"
    foreground = "#ffffff"
    frame_color = "#dc322f"
    timeout = 0
