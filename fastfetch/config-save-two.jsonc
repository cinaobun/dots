{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "small",
        "padding": { "top": 1 },
        "color": {
           "1": "#a5d6ff",
           "2": "#6489a9",
           "3": "#a5d6ff",
           "4": "#6489a9",
           "5": "#a5d6ff",
           "6": "#6489a9",
           "7": "#a5d6ff",
           "8": "#6489a9",
           "9": "#a5d6ff"
}
    },
    "display": {
        "constants": ["██ "],
        "separator": "",
        "key": { "width": 8 }
    },
    "modules": [
        "break",
        { "type": "wm", "key": " ", "keyColor": "#a5d6ff", "format": " " },
        { "type": "os", "key": "os", "keyColor": "#a5d6ff", "format": "nixos" },
        { "type": "wm", "key": "wm", "keyColor": "#a5d6ff", "format": "hyprland" },
        { "type": "command", "key": "ram", "keyColor": "#a5d6ff", "text": "free -m | awk 'NR==2 {print $3 \" / \" $2 \" MB\"}'" },
        { "type": "cpu", "key": "cpu", "keyColor": "#a5d6ff", "format": "i5 11th" },
        { "type": "gpu", "key": "gpu", "keyColor": "#a5d6ff", "format": "rtx 3060" }
    ]
}
