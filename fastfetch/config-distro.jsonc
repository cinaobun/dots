//  inspired by https://github.com/soloman28/My-Mango-Dotfiles/

{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "small",
        "padding": {
            "top": 0
        }
    },
    "display": {
        "separator": "  "
    },
    "modules": [
        {
            "type": "title",
        },
        {
            "key": "os      ",
            "type": "os",
            "format": "arch",
        },
        {
            "key": "wm      ",
            "type": "wm",
            "format": "hyprland",
        },
        {
            "key": "ram     ",
            "type": "command",
            "text": "free -m | awk 'NR==2 {print $3 \" / \" $2 \" MB\"}'",
        },
        {
            "key": "cpu     ",
            "type": "cpu",
            "format": "i5-11400f",
        },
        {
            "key": "gpu     ",
            "type": "gpu",
            "format": "rtx 3060",
        },
        {
            "type": "colors",
            "symbol": "square",
        }
    ]
}
