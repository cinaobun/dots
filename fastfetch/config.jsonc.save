{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "source": "~/.config/fastfetch/pngs/bocchi.png",
    "type": "kitty",
    "height": 10,
    "padding": {
      "top": 2,
    },
  },
  "display": {
    "separator": " ",
    "color": {
      "output": "#cad3f5",
    },
  },
  "modules": [
    {
      "key": "{#37}╭────────────╮",
      "type": "custom",
    },
    {
      "key": "{#37}│ {#31}  user     {#keys}{#37}│",
      "type": "title",
      "format": "{user-name}",
    },
    {
      "key": "{#37}│ {#31}  hname    {#keys}{#37}│",
      "type": "title",
      "format": "{host-name}",
    },
    {
      "key": "{#37}├────────────┤",
      "type": "custom",
      "format": "---",
    },
    {
      "key": "{#37}│ {#31}  desktop  {#keys}{#37}│",
      "type": "wm",
      "format": "{pretty-name}",
    },
    {
      "key": "{#37}│ {#31}  term     {#keys}{#37}│",
      "type": "terminal",
      "format": "{pretty-name}",
    },
    {
      "key": "{#37}│ {#31}  package  {#keys}{#37}│",
      "type": "command",
      "text": "~/.cache/fastfetch/pkgcount.sh",
    },
    {
      "key": "{#37}├────────────┤",
      "type": "custom",
      "format": "---",
    },
    {
      "key": "{#37}│ {#31}  cpu      {#keys}{#37}│",
      "type": "command",
      "text": "echo \"Intel Core $(lscpu | grep -oP 'i[3579]-\\d+[A-Z]*')\"",
    },
    {
      "key": "{#37}│ {#31}  gpu      {#keys}{#37}│",
      "type": "command",
      "text": "echo \"Nvidia $(nvidia-smi --query-gpu=name --format=csv,noheader | grep -oP 'RTX ?\\d+')\"",
    },
    {
      "key": "{#37}│ {#31}  mem      {#keys}{#37}│",
      "type": "memory",
    },
    {
      "key": "{#37}├────────────┤",
      "type": "custom",
      "format": "---",
    },
    {
      "key": "{#37}│ {#31}  colors   {#keys}{#37}│",
      "type": "colors",
      "symbol": "circle",
    },
    {
      "key": "{#37}╰────────────╯",
      "type": "custom",
    },
  ],
}
